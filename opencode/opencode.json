{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen-think",
  "small_model": "local/qwen-fast",
  "share": "disabled",
  "provider": {
    "local": {
      "name": "llama.cpp (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "none",
        "timeout": false,
        "headerTimeout": 900000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen-think": {
          "id": "qwen3.6-35b-a3b",
          "name": "Qwen3.6 35B-A3B abliterated (think)",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          }
        },
        "qwen-fast": {
          "id": "qwen3.6-35b-a3b",
          "name": "Qwen3.6 35B-A3B abliterated (fast, no think)",
          "tool_call": true,
          "reasoning": false,
          "temperature": true,
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          }
        }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-searxng@2.8.1"
      ],
      "environment": {
        "SEARXNG_URL": "http://127.0.0.1:8888"
      },
      "enabled": true
    }
  },
  "permission": {
    "execute": "ask"
  }
}