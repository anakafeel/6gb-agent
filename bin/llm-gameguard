#!/usr/bin/env bash
# Stop the LLM server whenever a game is running, so the game gets the VRAM and RAM.
# The server is not restarted afterwards; `oc` starts it on demand.
set -uo pipefail

# Steam starts every game (native and Proton) through `reaper SteamLaunch AppId=<id>`.
# Add more with e.g. GAME_PATTERN='reaper SteamLaunch AppId=|lutris-wrapper'.
GAME_PATTERN="${GAME_PATTERN:-reaper SteamLaunch AppId=}"
INTERVAL="${INTERVAL:-5}"

while true; do
  if pgrep -f "$GAME_PATTERN" >/dev/null; then
    for unit in llm llm-chat; do
      if systemctl --user is-active --quiet "$unit"; then
        echo "game detected, stopping $unit"
        systemctl --user stop "$unit"
      fi
    done
  fi
  sleep "$INTERVAL"
done
